{{#partial "content"}}

    <main class="wrap section--tight">

        <nav class="label" aria-label="Breadcrumb" style="margin-bottom:var(--s-4)">
            <a href="/shop/products">Shop</a> / <a href="/shop/products">Products</a> / <span>{{name}}</span></a>
        </nav>

        <div class="pdp">

            <div class="gallery">

                <div class="gallery__main">
                    <img data-gallery-main
                         src="https://images.unsplash.com/photo-1545241047-6083a3684587?w=1000&q=75&auto=format&fit=crop"
                         alt="Monstera deliciosa in a pale ceramic pot" width="1000" height="1000" fetchpriority="high"
                         decoding="async"/>
                </div>
                <div class="gallery__thumbs">
                    <button class="gallery__thumb" type="button" aria-current="true" aria-label="View main image"
                            data-gallery-thumb="https://images.unsplash.com/photo-1545241047-6083a3684587?w=1000&q=75&auto=format&fit=crop"
                            data-alt="Monstera deliciosa in a pale ceramic pot">
                        <img src="https://images.unsplash.com/photo-1545241047-6083a3684587?w=240&q=70&auto=format&fit=crop"
                             alt=""
                             width="240" height="240" loading="lazy"/>
                    </button>
                    <button class="gallery__thumb" type="button" aria-current="false" aria-label="View leaf detail"
                            data-gallery-thumb="https://images.unsplash.com/photo-1602923668104-8f9e03e77e62?w=1000&q=75&auto=format&fit=crop"
                            data-alt="Detail of patterned foliage">
                        <img src="https://images.unsplash.com/photo-1602923668104-8f9e03e77e62?w=240&q=70&auto=format&fit=crop"
                             alt="" width="240" height="240" loading="lazy"/>
                    </button>
                    <button class="gallery__thumb" type="button" aria-current="false" aria-label="View plant in a room"
                            data-gallery-thumb="https://images.unsplash.com/photo-1521334884684-d80222895322?w=1000&q=75&auto=format&fit=crop"
                            data-alt="The plant styled on a shelf beside a window">
                        <img src="https://images.unsplash.com/photo-1521334884684-d80222895322?w=240&q=70&auto=format&fit=crop"
                             alt="" width="240" height="240" loading="lazy"/>
                    </button>
                    <button class="gallery__thumb" type="button" aria-current="false" aria-label="View the nursery"
                            data-gallery-thumb="https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=1000&q=75&auto=format&fit=crop"
                            data-alt="The glasshouse where the plant was grown">
                        <img src="https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=240&q=70&auto=format&fit=crop"
                             alt="" width="240" height="240" loading="lazy"/>
                    </button>
                </div>
            </div>

            <div class="pdp__info">
                <!-- Badges
                <div>
                    <span class="badge badge--sale">Sale</span>
                    <span class="badge badge--stock"><span class="dot"></span>In stock — ships Tuesday</span>
                </div>
                -->

                <div>
                    <h1>{{name}}</h1>
                    <p class="product__latin" style="font-size:var(--text-sm);margin-top:4px">{{scientificName}}</p>
                </div>

                <div class="pdp__price price">
                    <span class="price__now num" data-variant-price>{{price}}</span>
                    <!-- Sale
                    <span class="price__was">£52.00</span>
                    <span class="badge badge--sale">Save 19%</span>
                    -->
                </div>

                <p class="lede" style="font-size:var(--text-sm)">
                    {{description}}
                </p>

                <!-- Portion selection
                <div>
                    <p class="label" style="margin-bottom:var(--s-3)">Pot size</p>
                    <div class="variants" role="group" aria-label="Pot size">
                        <button class="variant" type="button" aria-pressed="false" data-variant="12cm pot"
                                data-price="2800">12&nbsp;cm<small>£28.00</small></button>
                        <button class="variant" type="button" aria-pressed="true" data-variant="17cm pot"
                                data-price="4200">17&nbsp;cm<small>£42.00</small></button>
                        <button class="variant" type="button" aria-pressed="false" data-variant="24cm pot"
                                data-price="7400">24&nbsp;cm<small>£74.00</small></button>
                    </div>
                </div>
                -->

                <div style="display:flex;gap:var(--s-3);flex-wrap:wrap;align-items:center">
                    <form action="/shop/cart" method="POST">
                        <div class="qty" data-qty>
                            <input type="hidden" name="productId" value="{{id}}">
                            <input type="number" min="1" value="1" data-qty-input aria-label="Quantity"
                                   name="quantity"/>
                        </div>
                        <button class="btn btn--primary" type="submit" style="flex:1;min-width:180px"
                                data-image="https://images.unsplash.com/photo-1545241047-6083a3684587?w=200&q=70&auto=format&fit=crop">
                            Add to basket
                        </button>
                    </form>
                </div>

                <!-- Free delivery message
                <p class="label">Free delivery on orders over £40 — 30-day plant guarantee</p>
                -->

                <!-- Specs
                <dl class="specs">
                    <div class="specs__row">
                        <dt>Light</dt>
                        <dd>Bright indirect. Tolerates a shadier corner but grows slower.</dd>
                    </div>
                    <div class="specs__row">
                        <dt>Water</dt>
                        <dd>Weekly in summer, fortnightly in winter. Let the top 3&nbsp;cm dry.</dd>
                    </div>
                    <div class="specs__row">
                        <dt>Humidity</dt>
                        <dd>Average room is fine. Misting is optional and mostly for you.</dd>
                    </div>
                    <div class="specs__row">
                        <dt>Mature size</dt>
                        <dd>2&nbsp;m tall indoors over about five years.</dd>
                    </div>
                    <div class="specs__row">
                        <dt>Pets</dt>
                        <dd>Mildly toxic if chewed — keep out of reach of cats and dogs.</dd>
                    </div>
                    <div class="specs__row">
                        <dt>Difficulty</dt>
                        <dd>Easy. A good first large plant.</dd>
                    </div>
                </dl>
                -->

                <!-- Extra info, shipping etc
                <div class="acc">
                    <div class="acc__item">
                        <button class="acc__btn" type="button" aria-expanded="true" aria-controls="acc-1">
                            What arrives
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                        </button>
                        <div class="acc__panel" id="acc-1">
                            One three-year-old plant in a 17&nbsp;cm nursery pot, already fenestrated, plus a
                            peat-free potting note and a saucer. Decorative pots are sold separately.
                        </div>
                    </div>
                    <div class="acc__item">
                        <button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-2">
                            Delivery
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                        </button>
                        <div class="acc__panel" id="acc-2" hidden>
                            Dispatched Tuesday to Friday so nothing sits in a depot over a weekend. Free over
                            £40, otherwise £4.95. Mainland UK only for large sizes.
                        </div>
                    </div>
                    <div class="acc__item">
                        <button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-3">
                            Our guarantee
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 aria-hidden="true">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                        </button>
                        <div class="acc__panel" id="acc-3" hidden>
                            If it fails within thirty days we replace it. Tell us what happened — it helps us
                            grow better plants, and we will not ask you to prove anything.
                        </div>
                    </div>
                </div>
                -->

            </div>

        </div>

        <!-- Recommendations
