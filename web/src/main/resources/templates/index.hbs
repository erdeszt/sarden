                <a class="railcard" href="shop.html">
                    <img src="https://images.unsplash.com/photo-1466781783364-36c955e42a7f?w=340&q=72&auto=format&fit=crop"
                         alt="" width="340" height="340" loading="lazy" decoding="async"/>
                    <span class="railcard__meta"><span class="railcard__name">Cut stems</span><span class="railcard__n">12</span></span>
                </a>
                <a class="railcard" href="shop.html">
                    <img src="https://images.unsplash.com/photo-1459156212016-c812468e2115?w=340&q=72&auto=format&fit=crop"
