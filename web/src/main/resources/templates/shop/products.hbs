{{#partial "content"}}

    <main class="wrap section--tight">

        <nav class="label" aria-label="Breadcrumb" style="margin-bottom:var(--s-4)">
            <a href="index.html">Shop</a>
        </nav>

        <div class="shoplayout">

            <aside class="filters" aria-label="Filters">
                <div class="filters__group">
                    <p class="filters__title">Sort</p>
                    <label class="sr-only" for="sort">Sort by</label>
                    <select class="select" id="sort" data-sort style="width:auto">
                        <option value="featured">Featured</option>
                        <option value="price-asc">Price, low to high</option>
                        <option value="price-desc">Price, high to low</option>
                        <option value="name">Name, A–Z</option>
                    </select>
                </div>
                <div class="filters__group">
                    <p class="filters__title">Type</p>
                    {{#each categories}}
                        <label class="filters__row">
                            <input class="check" type="checkbox" data-filter-check="{{name}}"/>
                            {{name}} <span class="count">{{total}}</span>
                        </label>
                    {{/each}}
                </div>
                <button class="btn btn--ghost btn--sm" type="button" data-clear-filters>Clear all filters</button>
            </aside>

            <div class="grid grid--3" data-product-grid>

                {{#each products}}

                    <article class="product" data-tags="light-bright easy-care size-large sale" data-price="4200"
                             data-name="{{name}}" data-order="0" data-product>
                        <a class="product__media" href="/shop/product/{{id}}" aria-label="{{name}}">
                            <img src="https://images.unsplash.com/photo-1545241047-6083a3684587?w=700&q=72&auto=format&fit=crop"
                                 alt="{{name}}"
                                 width="700" height="875" fetchpriority="high" decoding="async"/>
                        </a>
                        <!-- Flags
                        <div class="product__flags"><span class="badge badge--sale">Sale</span></div>
                        -->
                        <!-- Wishlist
                        <button class="product__wish" type="button" aria-pressed="false"
                                aria-label="Save Monstera Deliciosa to wishlist">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 20s-7-4.5-7-9.2A4 4 0 0 1 12 8a4 4 0 0 1 7 2.8C19 15.5 12 20 12 20Z"/>
                            </svg>
                        </button>
                        -->
                        <!-- Add to basket
                        <div class="product__quick">
                            <button class="btn btn--primary btn--sm btn--block" type="button"
                                    data-add="monstera" data-name="Monstera Deliciosa" data-price="4200"
                                    data-image="https://images.unsplash.com/photo-1545241047-6083a3684587?w=200&q=72&auto=format&fit=crop"
                                    data-variant="12cm pot">
                                Add to basket
                            </button>
                        </div>
                        -->
                        <div class="product__body">
                            <a href="product.html"><h3 class="product__name">{{name}}</h3></a>
                            <p class="product__latin">{{scientificName}}</p>
                            <!-- Meta info
                            <div class="caremeta">
                                <span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                       stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path
                                    d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
                                    </svg>
                                    Bright indirect
                                </span>
                                <span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path
                                            d="M12 3s6 6.2 6 10a6 6 0 0 1-12 0c0-3.8 6-10 6-10Z"/>
                                    </svg>
                                    Weekly
                                </span>
                            </div>
                            -->
                            <div class="product__foot">
                                <span class="price__now">{{price}}</span>
                                <!-- Discount <span class="price__was">£52.00</span> -->
                                </span>
                            </div>
                        </div>
                    </article>

                {{/each}}

                <!-- No results:
                <div class="empty" data-no-results hidden>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round"
                         aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m20 20-3.5-3.5"/>
                    </svg>
                    <h2>Nothing matches those filters</h2>
                    <p>Try removing one — pet safe and low light together is a short list in any nursery.</p>
                    <button class="btn btn--primary btn--sm" type="button" data-clear-filters>Clear filters</button>
                </div>
                -->

            </div>

        </div>

    </main>

{{/partial}}

{{>layout}}
